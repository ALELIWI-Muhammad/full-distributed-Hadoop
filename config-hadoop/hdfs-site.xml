<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>

  <!-- Replication factor: each block is copied to 2 DataNodes -->
  <property>
    <name>dfs.replication</name>
    <value>2</value>
  </property>

  <!-- NameNode metadata storage directory -->
  <property>
    <name>dfs.namenode.name.dir</name>
    <value>/home/hadoop/hdfs/namenode</value>
  </property>

  <!-- DataNode block storage directory -->
  <property>
    <name>dfs.datanode.data.dir</name>
    <value>/home/hadoop/hdfs/datanode</value>
  </property>

  <!-- NameNode RPC address -->
  <property>
    <name>dfs.namenode.rpc-address</name>
    <value>namenode:9000</value>
  </property>

  <!-- NameNode HTTP address -->
  <property>
    <name>dfs.namenode.http-address</name>
    <value>namenode:9870</value>
  </property>

  <!-- ===== Kerberos security for HDFS ===== -->

  <!-- Kerberos principal for the NameNode -->
  <property>
    <name>dfs.namenode.kerberos.principal</name>
    <value>hdfs/namenode@HADOOP.LOCAL</value>
  </property>

  <!-- Keytab file for the NameNode -->
  <property>
    <name>dfs.namenode.keytab.file</name>
    <value>/etc/hadoop/keytabs/namenode.keytab</value>
  </property>

  <!-- HTTP/SPNEGO principal for the NameNode web UI -->
  <property>
    <name>dfs.namenode.kerberos.internal.spnego.principal</name>
    <value>HTTP/namenode@HADOOP.LOCAL</value>
  </property>

  <!--
    Kerberos principal for DataNodes.
    _HOST is automatically replaced with the DataNode hostname at runtime.
  -->
  <property>
    <name>dfs.datanode.kerberos.principal</name>
    <value>hdfs/_HOST@HADOOP.LOCAL</value>
  </property>

  <!-- Keytab file for DataNodes -->
  <property>
    <name>dfs.datanode.keytab.file</name>
    <value>/etc/hadoop/keytabs/datanode.keytab</value>
  </property>

  <!-- HTTP/SPNEGO principal for DataNode web UI -->
  <property>
    <name>dfs.datanode.kerberos.internal.spnego.principal</name>
    <value>HTTP/_HOST@HADOOP.LOCAL</value>
  </property>

  <!--
    Enable block access tokens.
    Mandatory when hadoop.security.authentication=kerberos.
    Prevents direct block access without authentication.
  -->
  <property>
    <name>dfs.block.access.token.enable</name>
    <value>true</value>
  </property>

  <!-- Enable HDFS permission checks -->
  <property>
    <name>dfs.permissions.enabled</name>
    <value>true</value>
  </property>

  <!-- Superuser group for HDFS -->
  <property>
    <name>dfs.permissions.superusergroup</name>
    <value>hadoop</value>
  </property>

  <!--
    Privileged ports for the secure DataNode (required with Kerberos).
    Hadoop requires ports < 1024 for the DataNode in Kerberos mode.
    jsvc binds these ports as root then drops privileges to the hadoop user.
    NOTE: In Docker, we use ignore.secure.ports.for.testing=true to bypass
    the privileged port requirement without needing jsvc capabilities.
  -->
  <property>
    <name>dfs.datanode.address</name>
    <value>0.0.0.0:9866</value>
    <description>DataNode data transfer port</description>
  </property>

  <property>
    <name>dfs.datanode.http.address</name>
    <value>0.0.0.0:9864</value>
    <description>DataNode HTTP port</description>
  </property>

  <!--
    Allow DataNode to start on non-privileged ports with Kerberos.
    This is safe in a Docker lab environment where network isolation
    is provided by Docker itself rather than OS-level port restrictions.
  -->
  <property>
    <name>ignore.secure.ports.for.testing</name>
    <value>true</value>
  </property>

  <!-- Permissions on the DataNode data directory -->
  <property>
    <name>dfs.datanode.data.dir.perm</name>
    <value>700</value>
  </property>

</configuration>
