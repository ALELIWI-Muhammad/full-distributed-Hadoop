<?xml version="1.0"?>
<configuration>

  <!-- Enable the MapReduce shuffle auxiliary service -->
  <property>
    <name>yarn.nodemanager.aux-services</name>
    <value>mapreduce_shuffle</value>
  </property>

  <!-- Environment variables propagated to YARN containers -->
  <property>
    <name>yarn.nodemanager.env-whitelist</name>
    <value>JAVA_HOME,HADOOP_COMMON_HOME,HADOOP_HDFS_HOME,HADOOP_CONF_DIR,CLASSPATH_PREPEND_DISTCACHE,HADOOP_YARN_HOME,HADOOP_HOME,PATH,LANG,TZ,HADOOP_MAPRED_HOME</value>
  </property>

  <!-- ResourceManager hostname -->
  <property>
    <name>yarn.resourcemanager.hostname</name>
    <value>namenode</value>
  </property>

  <!-- ===== Kerberos security for YARN ===== -->

  <!-- Kerberos principal for the ResourceManager -->
  <property>
    <name>yarn.resourcemanager.principal</name>
    <value>yarn/namenode@HADOOP.LOCAL</value>
  </property>

  <!-- Keytab for the ResourceManager -->
  <property>
    <name>yarn.resourcemanager.keytab</name>
    <value>/etc/hadoop/keytabs/namenode.keytab</value>
  </property>

  <!-- Kerberos principal for NodeManagers (_HOST replaced at runtime) -->
  <property>
    <name>yarn.nodemanager.principal</name>
    <value>yarn/_HOST@HADOOP.LOCAL</value>
  </property>

  <!-- Keytab for NodeManagers -->
  <property>
    <name>yarn.nodemanager.keytab</name>
    <value>/etc/hadoop/keytabs/datanode.keytab</value>
  </property>

  <!-- SPNEGO principal for the ResourceManager web UI -->
  <property>
    <name>yarn.resourcemanager.webapp.spnego-principal</name>
    <value>HTTP/namenode@HADOOP.LOCAL</value>
  </property>

  <property>
    <name>yarn.resourcemanager.webapp.spnego-keytab-file</name>
    <value>/etc/hadoop/keytabs/namenode.keytab</value>
  </property>

  <!-- SPNEGO principal for NodeManager web UIs -->
  <property>
    <name>yarn.nodemanager.webapp.spnego-principal</name>
    <value>HTTP/_HOST@HADOOP.LOCAL</value>
  </property>

  <property>
    <name>yarn.nodemanager.webapp.spnego-keytab-file</name>
    <value>/etc/hadoop/keytabs/datanode.keytab</value>
  </property>

</configuration>
